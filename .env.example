# 复制为 .env，scripts/start.ps1 与 dev.ps1 会安全加载；已有进程环境变量优先。
KW_MODE=production
KW_FAKE_PROVIDER=0
KW_ORIGIN=http://127.0.0.1:8000
KW_SECURE_COOKIE=0
# KW_DATA_DIR=C:/your-local-data/knowledge-world
# AI_CHAT_BASE_URL=https://your-provider.example/v1
# AI_CHAT_MODEL=your-text-model
# AI_CHAT_API_KEY=
# AI_VISION_BASE_URL=https://your-provider.example/v1
# AI_VISION_MODEL=your-vision-model
# AI_VISION_API_KEY=
# AI_IMAGE_BASE_URL=https://your-provider.example/v1
# AI_IMAGE_MODEL=your-image-model
# AI_IMAGE_API_KEY=
# 拾忆：设置页选择环境变量引用 SHIYI_API_KEY，地址也在设置页保存。
# SHIYI_API_KEY=
